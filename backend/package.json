    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdf-to-img": "^7.0.2",
    "pdfjs-dist": "~6.4.299",
    "tesseract.js": "^7.0.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pdfkit": "^0.20.2"
  },
  "engines": {
    "node": ">=20"
