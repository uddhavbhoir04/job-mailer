{
  "name": "job-mailer-backend",
  "version": "1.0.0",
  "description": "Job application email automation API",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test tests/*.test.js",
