# ---------- Server ----------
PORT=5000
# production => listens on 0.0.0.0 and REQUIRES APP_PASSWORD
NODE_ENV=development
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 in production
# HOST=
# Browser origins allowed to call the API (comma-separated), e.g. your Vercel URL
FRONTEND_ORIGIN=http://localhost:5173
# Password for the dashboard. Required when deployed (NODE_ENV=production).
APP_PASSWORD=
# Folder for the SQLite DB and uploads (point at a persistent disk when deployed)
# DATA_DIR=

# ---------- Gmail (never commit real values) ----------
# Your full Gmail address
GMAIL_USER=
# 16-character App Password from https://myaccount.google.com/apppasswords
# (spaces are fine, they are stripped). NOT your normal Gmail password.
GMAIL_APP_PASSWORD=

# ---------- Signature (can also be edited in the dashboard Settings) ----------
SENDER_NAME=
SENDER_PHONE=

# ---------- Sending behaviour ----------
# true = build every email but send nothing. Keep true until you've tested.
# This is only the starting value: the dashboard "Dry-run mode" checkbox can switch it.
# Set DRY_RUN_LOCKED=true to force dry-run and disable the checkbox.
DRY_RUN_LOCKED=false
DRY_RUN=true
# Delay between emails (ms). 30000 = 30s. Random +/-20% jitter is added.
EMAIL_DELAY_MS=30000
# After this many emails, pause for BATCH_PAUSE_MS
BATCH_SIZE=20
BATCH_PAUSE_MS=120000
# Retries for temporary SMTP errors (timeouts, 4xx)
MAX_RETRIES=3
# Gmail personal accounts allow ~500/day; stay below it
DAILY_SEND_LIMIT=400

# ---------- Uploads ----------
MAX_UPLOAD_MB=10
MAX_RESUME_MB=5

# Optional DNS MX check of every recipient domain during import
VALIDATE_MX=false
